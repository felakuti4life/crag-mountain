            crag.per_sample_yield %yc2, %gn2 : f32, f32
        } : (!crag.audio<f32, 48000, 1>, f32) -> (!crag.audio<f32, 48000, 1>, f32)
        crag.line_store %i, %tg2 group = "granulator3" slot = 16 lines = 64 : index, f32
        // LFE: silent.
        %ch3 = crag.scale %grain, %c0f : !crag.audio<f32, 48000, 1>, f32 -> !crag.audio<f32, 48000, 1>
        // BL at 210 degrees.
        %az4  = arith.constant 0.5833333333333334 : f32
        %gn4x = arith.constant 0.16666666666666666 : f32
        %gp4x = arith.constant 0.16666666666666666 : f32
        %dr4  = arith.subf %pos_f, %az4 : f32
        %dh4  = arith.addf %dr4, %chalf : f32
        %dfl4 = math.floor %dh4 : f32
        %dfr4 = arith.subf %dh4, %dfl4 : f32
        %ds4x = arith.subf %dfr4, %chalf : f32
        %cw4  = arith.cmpf oge, %ds4x, %c0f : f32
