        crag.line_store %i, %tg6 group = "granulator3" slot = 20 lines = 64 : index, f32
        // SR at 90 degrees.
        %az7  = arith.constant 0.25 : f32
        %gn7x = arith.constant 0.16666666666666666 : f32
        %gp7x = arith.constant 0.16666666666666666 : f32
        %dr7  = arith.subf %pos_f, %az7 : f32
        %dh7  = arith.addf %dr7, %chalf : f32
        %dfl7 = math.floor %dh7 : f32
        %dfr7 = arith.subf %dh7, %dfl7 : f32
        %ds7x = arith.subf %dfr7, %chalf : f32
        %cw7  = arith.cmpf oge, %ds7x, %c0f : f32
        %sp7  = arith.select %cw7, %gn7x, %gp7x : f32
        %da7  = math.absf %ds7x : f32
        %dn7  = arith.divf %da7, %sp7 : f32
        %dc7  = arith.minimumf %dn7, %c1f : f32
        %px7  = arith.subf %c1f, %dc7 : f32
        %px27 = arith.mulf %px7, %px7 : f32
        %pa7  = arith.mulf %px27, %pan_s5 : f32
        %pb7  = arith.addf %pa7, %pan_s3 : f32
        %pc7  = arith.mulf %pb7, %px27 : f32
        %pd7  = arith.addf %pc7, %pan_s1 : f32
        %ps7  = arith.mulf %pd7, %px7 : f32
        %tg7  = arith.mulf %ps7, %vol : f32
        %pv7  = crag.line_load %i group = "granulator3" slot = 21 lines = 64 : index -> f32
        %gd7  = arith.subf %tg7, %pv7 : f32
        %ds7  = arith.mulf %gd7, %ublk : f32
        %ch7, %ge7 = crag.per_sample (%grain) states (%pv7) {
          ^bbc7(%xc7: f32, %gc7: f32):
            %yc7 = arith.mulf %xc7, %gc7 : f32
            %gn7 = arith.addf %gc7, %ds7 : f32
            crag.per_sample_yield %yc7, %gn7 : f32, f32
        } : (!crag.audio<f32, 48000, 1>, f32) -> (!crag.audio<f32, 48000, 1>, f32)
        crag.line_store %i, %tg7 group = "granulator3" slot = 21 lines = 64 : index, f32

        %bus = crag.channel_join %ch0, %ch1, %ch2, %ch3, %ch4, %ch5, %ch6, %ch7
                  : (!crag.audio<f32, 48000, 1>, !crag.audio<f32, 48000, 1>, !crag.audio<f32, 48000, 1>, !crag.audio<f32, 48000, 1>, !crag.audio<f32, 48000, 1>, !crag.audio<f32, 48000, 1>, !crag.audio<f32, 48000, 1>, !crag.audio<f32, 48000, 1>) -> !crag.audio<f32, 48000, 8>
        crag.parallel_yield %bus : !crag.audio<f32, 48000, 8>
    }

    // ---------------------------------------------------------------------
    // Soft limiter: linear to the knee, then an asymptote at 1.  Dense clouds
    // have large momentary peaks that this rounds off.
    // ---------------------------------------------------------------------
    %out = crag.per_sample (%mix) states () {
      ^bbl(%y: f32):
        %knee  = arith.constant 0.8 : f32
        %room  = arith.constant 0.2 : f32
        %lim1  = arith.constant 1.0 : f32
        %lim0  = arith.constant 0.0 : f32
        %ya    = math.absf %y : f32
        %over  = arith.subf %ya, %knee : f32
        %ratio = arith.divf %over, %room : f32
        %den   = arith.addf %lim1, %ratio : f32
        %sq    = arith.divf %over, %den : f32
        %yl    = arith.addf %knee, %sq : f32
        %isov  = arith.cmpf ogt, %ya, %knee : f32
        %ym    = arith.select %isov, %yl, %ya : f32
        %yn    = arith.negf %ym : f32
        %isneg = arith.cmpf olt, %y, %lim0 : f32
        %yo    = arith.select %isneg, %yn, %ym : f32
        crag.per_sample_yield %yo : f32
    } : (!crag.audio<f32, 48000, 8>) -> !crag.audio<f32, 48000, 8>

    crag.output %out : !crag.audio<f32, 48000, 8>
  }
}
