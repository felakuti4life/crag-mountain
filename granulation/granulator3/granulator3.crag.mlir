        crag.line_store %i, %tg4 group = "granulator3" slot = 18 lines = 64 : index, f32
        // BR at 150 degrees.
        %az5  = arith.constant 0.4166666666666667 : f32
        %gn5x = arith.constant 0.16666666666666666 : f32
        %gp5x = arith.constant 0.16666666666666666 : f32
