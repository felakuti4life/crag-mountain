        %dn2  = arith.divf %da2, %sp2 : f32
        %dc2  = arith.minimumf %dn2, %c1f : f32
        %px2  = arith.subf %c1f, %dc2 : f32
        %px22 = arith.mulf %px2, %px2 : f32
        %pa2  = arith.mulf %px22, %pan_s5 : f32
        %pb2  = arith.addf %pa2, %pan_s3 : f32
        %pc2  = arith.mulf %pb2, %px22 : f32
        %pd2  = arith.addf %pc2, %pan_s1 : f32
        %ps2  = arith.mulf %pd2, %px2 : f32
        %tg2  = arith.mulf %ps2, %vol : f32
        %pv2  = crag.line_load %i group = "granulator3" slot = 16 lines = 64 : index -> f32
        %gd2  = arith.subf %tg2, %pv2 : f32
