        %pb6  = arith.addf %pa6, %pan_s3 : f32
        %pc6  = arith.mulf %pb6, %px26 : f32
        %pd6  = arith.addf %pc6, %pan_s1 : f32
        %ps6  = arith.mulf %pd6, %px6 : f32
        %tg6  = arith.mulf %ps6, %vol : f32
        %pv6  = crag.line_load %i group = "granulator3" slot = 20 lines = 64 : index -> f32
        %gd6  = arith.subf %tg6, %pv6 : f32
        %ds6  = arith.mulf %gd6, %ublk : f32
        %ch6, %ge6 = crag.per_sample (%grain) states (%pv6) {
