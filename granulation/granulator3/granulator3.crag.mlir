        %dh5  = arith.addf %dr5, %chalf : f32
        %dfl5 = math.floor %dh5 : f32
        %dfr5 = arith.subf %dh5, %dfl5 : f32
        %ds5x = arith.subf %dfr5, %chalf : f32
        %cw5  = arith.cmpf oge, %ds5x, %c0f : f32
        %sp5  = arith.select %cw5, %gn5x, %gp5x : f32
        %da5  = math.absf %ds5x : f32
        %dn5  = arith.divf %da5, %sp5 : f32
        %dc5  = arith.minimumf %dn5, %c1f : f32
        %px5  = arith.subf %c1f, %dc5 : f32
        %px25 = arith.mulf %px5, %px5 : f32
        %pa5  = arith.mulf %px25, %pan_s5 : f32
        %pb5  = arith.addf %pa5, %pan_s3 : f32
        %pc5  = arith.mulf %pb5, %px25 : f32
        %pd5  = arith.addf %pc5, %pan_s1 : f32
        %ps5  = arith.mulf %pd5, %px5 : f32
        %tg5  = arith.mulf %ps5, %vol : f32
        %pv5  = crag.line_load %i group = "granulator3" slot = 19 lines = 64 : index -> f32
        %gd5  = arith.subf %tg5, %pv5 : f32
