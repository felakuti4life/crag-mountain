        %dh6  = arith.addf %dr6, %chalf : f32
        %dfl6 = math.floor %dh6 : f32
        %dfr6 = arith.subf %dh6, %dfl6 : f32
        %ds6x = arith.subf %dfr6, %chalf : f32
        %cw6  = arith.cmpf oge, %ds6x, %c0f : f32
        %sp6  = arith.select %cw6, %gn6x, %gp6x : f32
