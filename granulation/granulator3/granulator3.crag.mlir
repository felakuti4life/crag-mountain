        %pa4  = arith.mulf %px24, %pan_s5 : f32
        %pb4  = arith.addf %pa4, %pan_s3 : f32
        %pc4  = arith.mulf %pb4, %px24 : f32
        %pd4  = arith.addf %pc4, %pan_s1 : f32
        %ps4  = arith.mulf %pd4, %px4 : f32
        %tg4  = arith.mulf %ps4, %vol : f32
        %pv4  = crag.line_load %i group = "granulator3" slot = 18 lines = 64 : index -> f32
        %gd4  = arith.subf %tg4, %pv4 : f32
        %ds4  = arith.mulf %gd4, %ublk : f32
        %ch4, %ge4 = crag.per_sample (%grain) states (%pv4) {
