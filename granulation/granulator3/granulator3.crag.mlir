        %sp1  = arith.select %cw1, %gn1x, %gp1x : f32
        %da1  = math.absf %ds1x : f32
        %dn1  = arith.divf %da1, %sp1 : f32
        %dc1  = arith.minimumf %dn1, %c1f : f32
        %px1  = arith.subf %c1f, %dc1 : f32
        %px21 = arith.mulf %px1, %px1 : f32
        %pa1  = arith.mulf %px21, %pan_s5 : f32
        %pb1  = arith.addf %pa1, %pan_s3 : f32
        %pc1  = arith.mulf %pb1, %px21 : f32
        %pd1  = arith.addf %pc1, %pan_s1 : f32
        %ps1  = arith.mulf %pd1, %px1 : f32
        %tg1  = arith.mulf %ps1, %vol : f32
        %pv1  = crag.line_load %i group = "granulator3" slot = 15 lines = 64 : index -> f32
        %gd1  = arith.subf %tg1, %pv1 : f32
        %ds1  = arith.mulf %gd1, %ublk : f32
        %ch1, %ge1 = crag.per_sample (%grain) states (%pv1) {
          ^bbc1(%xc1: f32, %gc1: f32):
            %yc1 = arith.mulf %xc1, %gc1 : f32
            %gn1 = arith.addf %gc1, %ds1 : f32
            crag.per_sample_yield %yc1, %gn1 : f32, f32
        } : (!crag.audio<f32, 48000, 1>, f32) -> (!crag.audio<f32, 48000, 1>, f32)
        crag.line_store %i, %tg1 group = "granulator3" slot = 15 lines = 64 : index, f32
        // FC at 0 degrees.
        %az2  = arith.constant 0.0 : f32
        %gn2x = arith.constant 0.08333333333333333 : f32
        %gp2x = arith.constant 0.08333333333333333 : f32
        %dr2  = arith.subf %pos_f, %az2 : f32
        %dh2  = arith.addf %dr2, %chalf : f32
        %dfl2 = math.floor %dh2 : f32
        %dfr2 = arith.subf %dh2, %dfl2 : f32
        %ds2x = arith.subf %dfr2, %chalf : f32
