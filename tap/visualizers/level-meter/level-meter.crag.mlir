    %flt19 = crag.filter %osc6, %fb17, %ff18 : (!crag.audio<f32, 0, 1>, !crag.coeff_vec, !crag.coeff_vec) -> !crag.audio<f32, 0, 1>
    %c22 = arith.constant 0.5 : f32
    %c25 = arith.constant 0.5 : f32
    %c27 = arith.constant 0.0 : f32
    %osc28 = crag.sine %c25, %c27 : f32, f32 -> !crag.audio<f32, 0, 1>
    %c30 = arith.constant 0.5 : f32
    %c32 = arith.constant 0.6 : f32
    %ps33 = crag.per_sample (%flt19, %osc28) states () {
    ^bb0(%x0_0: f32, %x0_1: f32):
      %v23 = arith.mulf %x0_1, %c30 : f32
      %v20 = arith.addf %c22, %v23 : f32
      %v1 = arith.mulf %x0_0, %v20 : f32
      %v0 = arith.mulf %v1, %c32 : f32
      crag.per_sample_yield %v0 : f32
    } : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> (!crag.audio<f32, 0, 1>)
    crag.visualizer_ref "meter"(%ps33) : (!crag.audio<f32, 0, 1>)
    crag.visualizer_ref "scope"(%ps33) : (!crag.audio<f32, 0, 1>)
    crag.output %ps33 : !crag.audio<f32, 0, 1>
  }
}
