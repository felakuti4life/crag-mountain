// 5.1 to Mono (Equal-Power)
//
// Each output averages the inputs folded into it with squared weights summing
// to 1, so uncorrelated content keeps its loudness.
// The LFE is dropped.
//
// Gains (rows: outputs, columns: inputs):
//
//             FL      FR      FC     LFE      BL      BR
//   C     0.4472  0.4472  0.4472       0  0.4472  0.4472
//
// Conversion: channels 6 -> 1
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "51_to_mono_equal_power" sample_rate = 0 channels = 1 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 6>):
    %fl = crag.channel_slice %in, 0 : !crag.audio<f32, 0, 6> -> !crag.audio<f32, 0, 1>
    %fr = crag.channel_slice %in, 1 : !crag.audio<f32, 0, 6> -> !crag.audio<f32, 0, 1>
    %fc = crag.channel_slice %in, 2 : !crag.audio<f32, 0, 6> -> !crag.audio<f32, 0, 1>
    %bl = crag.channel_slice %in, 4 : !crag.audio<f32, 0, 6> -> !crag.audio<f32, 0, 1>
    %br = crag.channel_slice %in, 5 : !crag.audio<f32, 0, 6> -> !crag.audio<f32, 0, 1>
    %k0 = arith.constant 0.447213595 : f32
    %c_fl = crag.scale %fl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_fr = crag.scale %fr, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_fc = crag.scale %fc, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_bl = crag.scale %bl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_br = crag.scale %br, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_out = crag.sum %c_fl, %c_fr, %c_fc, %c_bl, %c_br : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    crag.output %c_out : !crag.audio<f32, 0, 1>
  }
}
