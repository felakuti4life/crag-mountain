// 5.1 to Quad (Linear)
//
// Each output averages the inputs folded into it with weights summing to 1, so
// correlated content keeps its level and cannot clip.
// The LFE is dropped.
//
// Gains (rows: outputs, columns: inputs):
//
//             FL      FR      FC     LFE      BL      BR
//   FL    0.5000       0  0.5000       0       0       0
//   FR         0  0.5000  0.5000       0       0       0
//   BL         0       0       0       0  1.0000       0
//   BR         0       0       0       0       0  1.0000
//
// Conversion: channels 6 -> 4
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "51_to_quad_linear" sample_rate = 0 channels = 4 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 6>):
    %fl = crag.channel_slice %in, 0 : !crag.audio<f32, 0, 6> -> !crag.audio<f32, 0, 1>
    %fr = crag.channel_slice %in, 1 : !crag.audio<f32, 0, 6> -> !crag.audio<f32, 0, 1>
    %fc = crag.channel_slice %in, 2 : !crag.audio<f32, 0, 6> -> !crag.audio<f32, 0, 1>
    %bl = crag.channel_slice %in, 4 : !crag.audio<f32, 0, 6> -> !crag.audio<f32, 0, 1>
    %br = crag.channel_slice %in, 5 : !crag.audio<f32, 0, 6> -> !crag.audio<f32, 0, 1>
    %k0 = arith.constant 0.5 : f32
    %fl_fl = crag.scale %fl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fl_fc = crag.scale %fc, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fl_out = crag.sum %fl_fl, %fl_fc : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    %fr_fr = crag.scale %fr, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fr_fc = crag.scale %fc, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fr_out = crag.sum %fr_fr, %fr_fc : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    %out = crag.channel_join %fl_out, %fr_out, %bl, %br : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 4>
    crag.output %out : !crag.audio<f32, 0, 4>
  }
}
