// Stereo to Mono (Equal-Power)
//
// Each output averages the inputs folded into it with squared weights summing
// to 1, so uncorrelated content keeps its loudness.
//
// Gains (rows: outputs, columns: inputs):
//
//            L       R
//   C   0.7071  0.7071
//
// Conversion: channels 2 -> 1
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "stereo_to_mono_equal_power" sample_rate = 0 channels = 1 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 2>):
    %l = crag.channel_slice %in, 0 : !crag.audio<f32, 0, 2> -> !crag.audio<f32, 0, 1>
    %r = crag.channel_slice %in, 1 : !crag.audio<f32, 0, 2> -> !crag.audio<f32, 0, 1>
    %k0 = arith.constant 0.707106781 : f32
    %c_l = crag.scale %l, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_r = crag.scale %r, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_out = crag.sum %c_l, %c_r : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    crag.output %c_out : !crag.audio<f32, 0, 1>
  }
}
