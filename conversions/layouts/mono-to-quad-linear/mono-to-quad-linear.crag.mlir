// Mono to Quad (Linear)
//
// An input feeding several outputs is split with gains summing to 1.
// BL, BR stay silent: inputs keep their positions rather than being spread for
// ambience.
//
// Gains (rows: outputs, columns: inputs):
//
//             C
//   FL   0.5000
//   FR   0.5000
//   BL        0
//   BR        0
//
// Conversion: channels 1 -> 4
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "mono_to_quad_linear" sample_rate = 0 channels = 4 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 1>):
    %k0 = arith.constant 0.5 : f32
    %fl_c = crag.scale %in, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fr_c = crag.scale %in, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %k1 = arith.constant 0.0 : f32
    %bl_out = crag.scale %in, %k1 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %br_out = crag.scale %in, %k1 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %out = crag.channel_join %fl_c, %fr_c, %bl_out, %br_out : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 4>
    crag.output %out : !crag.audio<f32, 0, 4>
  }
}
