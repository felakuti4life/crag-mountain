// Stereo to 5.1 (Linear)
//
// An input feeding several outputs is split with gains summing to 1.
// The LFE stays silent. FC, BL, BR stay silent: inputs keep their positions
// rather than being spread for ambience.
//
// Gains (rows: outputs, columns: inputs):
//
//              L       R
//   FL    1.0000       0
//   FR         0  1.0000
//   FC         0       0
//   LFE        0       0
//   BL         0       0
//   BR         0       0
//
// Conversion: channels 2 -> 6
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "stereo_to_51_linear" sample_rate = 0 channels = 6 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 2>):
    %l = crag.channel_slice %in, 0 : !crag.audio<f32, 0, 2> -> !crag.audio<f32, 0, 1>
    %r = crag.channel_slice %in, 1 : !crag.audio<f32, 0, 2> -> !crag.audio<f32, 0, 1>
    %k0 = arith.constant 0.0 : f32
    %fc_out = crag.scale %l, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %lfe_out = crag.scale %l, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %bl_out = crag.scale %l, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %br_out = crag.scale %l, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %out = crag.channel_join %l, %r, %fc_out, %lfe_out, %bl_out, %br_out : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 6>
    crag.output %out : !crag.audio<f32, 0, 6>
  }
}
