// Stereo to Quad (Linear)
//
// An input feeding several outputs is split with gains summing to 1.
// BL, BR stay silent: inputs keep their positions rather than being spread for
// ambience.
//
// Gains (rows: outputs, columns: inputs):
//
//             L       R
//   FL   1.0000       0
//   FR        0  1.0000
//   BL        0       0
//   BR        0       0
//
// Conversion: channels 2 -> 4
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "stereo_to_quad_linear" sample_rate = 0 channels = 4 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 2>):
    %l = crag.channel_slice %in, 0 : !crag.audio<f32, 0, 2> -> !crag.audio<f32, 0, 1>
    %r = crag.channel_slice %in, 1 : !crag.audio<f32, 0, 2> -> !crag.audio<f32, 0, 1>
    %k0 = arith.constant 0.0 : f32
    %bl_out = crag.scale %l, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %br_out = crag.scale %l, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %out = crag.channel_join %l, %r, %bl_out, %br_out : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 4>
    crag.output %out : !crag.audio<f32, 0, 4>
  }
}
