// 7.1 to 5.1 (Linear)
//
// Each output averages the inputs folded into it with weights summing to 1, so
// correlated content keeps its level and cannot clip.
//
// Gains (rows: outputs, columns: inputs):
//
//             FL      FR      FC     LFE      BL      BR      SL      SR
//   FL    0.5000       0       0       0       0       0  0.5000       0
//   FR         0  0.5000       0       0       0       0       0  0.5000
//   FC         0       0  1.0000       0       0       0       0       0
//   LFE        0       0       0  1.0000       0       0       0       0
//   BL         0       0       0       0  0.5000       0  0.5000       0
//   BR         0       0       0       0       0  0.5000       0  0.5000
//
// Conversion: channels 8 -> 6
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "71_to_51_linear" sample_rate = 0 channels = 6 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 8>):
    %fl = crag.channel_slice %in, 0 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %fr = crag.channel_slice %in, 1 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %fc = crag.channel_slice %in, 2 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %lfe = crag.channel_slice %in, 3 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %bl = crag.channel_slice %in, 4 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %br = crag.channel_slice %in, 5 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %sl = crag.channel_slice %in, 6 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %sr = crag.channel_slice %in, 7 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %k0 = arith.constant 0.5 : f32
    %fl_fl = crag.scale %fl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fl_sl = crag.scale %sl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fl_out = crag.sum %fl_fl, %fl_sl : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    %fr_fr = crag.scale %fr, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fr_sr = crag.scale %sr, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fr_out = crag.sum %fr_fr, %fr_sr : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    %bl_bl = crag.scale %bl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %bl_sl = crag.scale %sl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %bl_out = crag.sum %bl_bl, %bl_sl : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    %br_br = crag.scale %br, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %br_sr = crag.scale %sr, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %br_out = crag.sum %br_br, %br_sr : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    %out = crag.channel_join %fl_out, %fr_out, %fc, %lfe, %bl_out, %br_out : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 6>
    crag.output %out : !crag.audio<f32, 0, 6>
