// Mono to 7.1 (Equal-Power)
//
// An input feeding several outputs is split with squared gains summing to 1.
// The LFE stays silent. FL, FR, BL, BR, SL, SR stay silent: inputs keep their
// positions rather than being spread for ambience.
//
// Gains (rows: outputs, columns: inputs):
//
//              C
//   FL         0
//   FR         0
//   FC    1.0000
//   LFE        0
//   BL         0
//   BR         0
//   SL         0
//   SR         0
//
// Conversion: channels 1 -> 8
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "mono_to_71_equal_power" sample_rate = 0 channels = 8 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 1>):
    %k0 = arith.constant 0.0 : f32
    %fl_out = crag.scale %in, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fr_out = crag.scale %in, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %lfe_out = crag.scale %in, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %bl_out = crag.scale %in, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %br_out = crag.scale %in, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %sl_out = crag.scale %in, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %sr_out = crag.scale %in, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %out = crag.channel_join %fl_out, %fr_out, %in, %lfe_out, %bl_out, %br_out, %sl_out, %sr_out : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 8>
    crag.output %out : !crag.audio<f32, 0, 8>
  }
}
