  ^bb0(%in: !crag.audio<f32, 0, 8>):
    %fl = crag.channel_slice %in, 0 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %fr = crag.channel_slice %in, 1 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %fc = crag.channel_slice %in, 2 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %bl = crag.channel_slice %in, 4 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %br = crag.channel_slice %in, 5 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %sl = crag.channel_slice %in, 6 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %sr = crag.channel_slice %in, 7 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %k0 = arith.constant 0.142857143 : f32
    %c_fl = crag.scale %fl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_fr = crag.scale %fr, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_fc = crag.scale %fc, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_bl = crag.scale %bl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_br = crag.scale %br, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_sl = crag.scale %sl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_sr = crag.scale %sr, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_out = crag.sum %c_fl, %c_fr, %c_fc, %c_bl, %c_br, %c_sl, %c_sr : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    crag.output %c_out : !crag.audio<f32, 0, 1>
  }
}
