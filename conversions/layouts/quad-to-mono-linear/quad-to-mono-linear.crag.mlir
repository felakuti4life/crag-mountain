// Quad to Mono (Linear)
//
// Each output averages the inputs folded into it with weights summing to 1, so
// correlated content keeps its level and cannot clip.
//
// Gains (rows: outputs, columns: inputs):
//
//            FL      FR      BL      BR
//   C    0.2500  0.2500  0.2500  0.2500
//
// Conversion: channels 4 -> 1
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "quad_to_mono_linear" sample_rate = 0 channels = 1 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 4>):
    %fl = crag.channel_slice %in, 0 : !crag.audio<f32, 0, 4> -> !crag.audio<f32, 0, 1>
    %fr = crag.channel_slice %in, 1 : !crag.audio<f32, 0, 4> -> !crag.audio<f32, 0, 1>
    %bl = crag.channel_slice %in, 2 : !crag.audio<f32, 0, 4> -> !crag.audio<f32, 0, 1>
    %br = crag.channel_slice %in, 3 : !crag.audio<f32, 0, 4> -> !crag.audio<f32, 0, 1>
    %k0 = arith.constant 0.25 : f32
    %c_fl = crag.scale %fl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_fr = crag.scale %fr, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_bl = crag.scale %bl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_br = crag.scale %br, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %c_out = crag.sum %c_fl, %c_fr, %c_bl, %c_br : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    crag.output %c_out : !crag.audio<f32, 0, 1>
  }
}
