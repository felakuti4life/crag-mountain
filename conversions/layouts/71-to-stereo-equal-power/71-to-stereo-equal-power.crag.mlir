// 7.1 to Stereo (Equal-Power)
//
// Each output averages the inputs folded into it with squared weights summing
// to 1, so uncorrelated content keeps its loudness.
// The LFE is dropped.
//
// Gains (rows: outputs, columns: inputs):
//
//             FL      FR      FC     LFE      BL      BR      SL      SR
//   L     0.5000       0  0.5000       0  0.5000       0  0.5000       0
//   R          0  0.5000  0.5000       0       0  0.5000       0  0.5000
//
// Conversion: channels 8 -> 2
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "71_to_stereo_equal_power" sample_rate = 0 channels = 2 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 8>):
    %fl = crag.channel_slice %in, 0 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %fr = crag.channel_slice %in, 1 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %fc = crag.channel_slice %in, 2 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %bl = crag.channel_slice %in, 4 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %br = crag.channel_slice %in, 5 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %sl = crag.channel_slice %in, 6 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %sr = crag.channel_slice %in, 7 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %k0 = arith.constant 0.5 : f32
    %l_fl = crag.scale %fl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %l_fc = crag.scale %fc, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %l_bl = crag.scale %bl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %l_sl = crag.scale %sl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %l_out = crag.sum %l_fl, %l_fc, %l_bl, %l_sl : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    %r_fr = crag.scale %fr, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %r_fc = crag.scale %fc, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %r_br = crag.scale %br, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %r_sr = crag.scale %sr, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %r_out = crag.sum %r_fr, %r_fc, %r_br, %r_sr : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    %out = crag.channel_join %l_out, %r_out : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 2>
    crag.output %out : !crag.audio<f32, 0, 2>
  }
}
