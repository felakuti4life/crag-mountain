// 7.1 to Quad (Equal-Power)
//
// Each output averages the inputs folded into it with squared weights summing
// to 1, so uncorrelated content keeps its loudness.
// The LFE is dropped.
//
// Gains (rows: outputs, columns: inputs):
//
//             FL      FR      FC     LFE      BL      BR      SL      SR
//   FL    0.5774       0  0.5774       0       0       0  0.5774       0
//   FR         0  0.5774  0.5774       0       0       0       0  0.5774
//   BL         0       0       0       0  0.7071       0  0.7071       0
//   BR         0       0       0       0       0  0.7071       0  0.7071
//
// Conversion: channels 8 -> 4
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "71_to_quad_equal_power" sample_rate = 0 channels = 4 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 8>):
    %fl = crag.channel_slice %in, 0 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %fr = crag.channel_slice %in, 1 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %fc = crag.channel_slice %in, 2 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %bl = crag.channel_slice %in, 4 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %br = crag.channel_slice %in, 5 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %sl = crag.channel_slice %in, 6 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %sr = crag.channel_slice %in, 7 : !crag.audio<f32, 0, 8> -> !crag.audio<f32, 0, 1>
    %k0 = arith.constant 0.577350269 : f32
    %fl_fl = crag.scale %fl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fl_fc = crag.scale %fc, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fl_sl = crag.scale %sl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fl_out = crag.sum %fl_fl, %fl_fc, %fl_sl : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    %fr_fr = crag.scale %fr, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fr_fc = crag.scale %fc, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fr_sr = crag.scale %sr, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %fr_out = crag.sum %fr_fr, %fr_fc, %fr_sr : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    %k1 = arith.constant 0.707106781 : f32
    %bl_bl = crag.scale %bl, %k1 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %bl_sl = crag.scale %sl, %k1 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %bl_out = crag.sum %bl_bl, %bl_sl : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    %br_br = crag.scale %br, %k1 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %br_sr = crag.scale %sr, %k1 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %br_out = crag.sum %br_br, %br_sr : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 1>
    %out = crag.channel_join %fl_out, %fr_out, %bl_out, %br_out : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 4>
    crag.output %out : !crag.audio<f32, 0, 4>
  }
}
