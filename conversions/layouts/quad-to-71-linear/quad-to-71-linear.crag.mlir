// Quad to 7.1 (Linear)
//
// An input feeding several outputs is split with gains summing to 1.
// The LFE stays silent. FC, SL, SR stay silent: inputs keep their positions
// rather than being spread for ambience.
//
// Gains (rows: outputs, columns: inputs):
//
//             FL      FR      BL      BR
//   FL    1.0000       0       0       0
//   FR         0  1.0000       0       0
//   FC         0       0       0       0
//   LFE        0       0       0       0
//   BL         0       0  1.0000       0
//   BR         0       0       0  1.0000
//   SL         0       0       0       0
//   SR         0       0       0       0
//
// Conversion: channels 4 -> 8
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "quad_to_71_linear" sample_rate = 0 channels = 8 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 4>):
    %fl = crag.channel_slice %in, 0 : !crag.audio<f32, 0, 4> -> !crag.audio<f32, 0, 1>
    %fr = crag.channel_slice %in, 1 : !crag.audio<f32, 0, 4> -> !crag.audio<f32, 0, 1>
    %bl = crag.channel_slice %in, 2 : !crag.audio<f32, 0, 4> -> !crag.audio<f32, 0, 1>
    %br = crag.channel_slice %in, 3 : !crag.audio<f32, 0, 4> -> !crag.audio<f32, 0, 1>
    %k0 = arith.constant 0.0 : f32
    %fc_out = crag.scale %fl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %lfe_out = crag.scale %fl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %sl_out = crag.scale %fl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %sr_out = crag.scale %fl, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %out = crag.channel_join %fl, %fr, %fc_out, %lfe_out, %bl, %br, %sl_out, %sr_out : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 8>
    crag.output %out : !crag.audio<f32, 0, 8>
  }
}
