// Mono to Stereo (Linear)
//
// An input feeding several outputs is split with gains summing to 1.
//
// Gains (rows: outputs, columns: inputs):
//
//            C
//   L   0.5000
//   R   0.5000
//
// Conversion: channels 1 -> 2
// Generated by scripts/gen/gen_channel_layouts.py; edit the generator,
// not this file.

module {
  crag.graph name = "mono_to_stereo_linear" sample_rate = 0 channels = 2 default_visualizer = "oscilloscope" {
  ^bb0(%in: !crag.audio<f32, 0, 1>):
    %k0 = arith.constant 0.5 : f32
    %l_c = crag.scale %in, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %r_c = crag.scale %in, %k0 : !crag.audio<f32, 0, 1>, f32 -> !crag.audio<f32, 0, 1>
    %out = crag.channel_join %l_c, %r_c : (!crag.audio<f32, 0, 1>, !crag.audio<f32, 0, 1>) -> !crag.audio<f32, 0, 2>
    crag.output %out : !crag.audio<f32, 0, 2>
  }
}
